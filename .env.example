# Choose the active profile from `.harness/llm.json`.
SFAH_ACTIVE_LLM_PROFILE=openai_compat

# -----------------------------------------------------------------------------
# OpenAI-compatible profile
# Fill in the API URL and API key below.
# If you use the official OpenAI endpoint, keep the default base URL.
# -----------------------------------------------------------------------------
SFAH_OPENAI_COMPAT_API_KEY=your_openai_compatible_api_key_here
SFAH_OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
SFAH_OPENAI_COMPAT_MODEL=gpt-5.4
SFAH_OPENAI_COMPAT_TIMEOUT_SECONDS=90

# Optional relay / compatible provider example:
# SFAH_OPENAI_COMPAT_BASE_URL=https://your-api-host.example/v1

# -----------------------------------------------------------------------------
# Anthropic profile
# Fill in the API URL and API key below only if you plan to use this profile.
# -----------------------------------------------------------------------------
SFAH_ANTHROPIC_API_KEY=your_anthropic_api_key_here
SFAH_ANTHROPIC_BASE_URL=https://api.anthropic.com
SFAH_ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Optional legacy fallback names supported by this project for openai_compat:
# HARNESS_LLM_API_KEY=your_openai_compatible_api_key_here
# HARNESS_LLM_BASE_URL=https://your-api-host.example/v1
# HARNESS_LLM_MODEL=gpt-5.4

# Optional: keep this commented if you want the built-in mock profile.
# SFAH_ACTIVE_LLM_PROFILE=mock

# UI step-specific API keys. These are written automatically when you save
# model settings in the web workbench. Leave blank to inherit defaults.
SFAH_STEP_DISCOVERY_API_KEY=
SFAH_STEP_SPEC_API_KEY=
SFAH_STEP_PLAN_API_KEY=
SFAH_STEP_TASKS_API_KEY=
SFAH_STEP_EXECUTION_API_KEY=
SFAH_STEP_REVIEW_API_KEY=
SFAH_STEP_AUTO_API_KEY=
